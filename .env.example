# This file lists the environment variables required for the FESt System backend.
# Copy this file to `.env` in the same directory and populate it with your actual values. :)

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=your_database_password_here
DB_NAME=fest_db_v2

# Security (CRITICAL - Server will crash without this)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
PORT=3000
